# ─────────────────────────────────────────────────────────────────────────────
# OCR RAG Pipeline — environment configuration
# Copy to .env and fill in:  cp .env.example .env
# Every variable is optional unless marked REQUIRED — empty values fall back
# to the defaults in app/config.py.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
DEBUG=false                      # true enables debug endpoints/middleware

# ── LLM Provider selection (Factory — ONE active provider at a time) ────────
# The LLMProviderFactory (app/gateway/adapters/factory.py) instantiates exactly
# one adapter for this provider; all chat/vision calls go through it. The
# auto-switcher may flip the active provider at runtime (outage/budget), but
# still only one is ever served.
LLM_PROVIDER=openai              # openai | anthropic | azure | bedrock | deepseek | google | local
                                 #   openai  — OpenAI direct (gpt-4o family + embeddings)
                                 #   anthropic — Claude (no embedding model — embeddings
                                 #              automatically fall back to openai/azure)
                                 #   azure   — Azure AI / Azure OpenAI (deployments, see below)
                                 #   bedrock — AWS Bedrock Claude  [ADR-0002 — adapter
                                 #              pending build; needs `pip install -e .[aws]`]
                                 #   deepseek — DeepSeek V4 (ADR-0006 — OpenAI-compatible;
                                 #              no embeddings — falls back to openai/azure)
                                 #   google / local — reserved, adapters not built yet

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=                  # REQUIRED if LLM_PROVIDER=openai
                                 # Get one: https://platform.openai.com/api-keys

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=               # REQUIRED if LLM_PROVIDER=anthropic
                                 # Get one: https://console.anthropic.com/settings/keys
                                 # Note: anthropic has no embedding model — gateway_embed
                                 # falls back to OpenAI or Azure automatically.

# ── Google (reserved) ────────────────────────────────────────────────────────
GOOGLE_API_KEY=                  # For a future Vertex AI / Gemini adapter (not built yet)

# ── Azure AI (Azure OpenAI) ──────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=            # REQUIRED if LLM_PROVIDER=azure
                                 # Azure portal → your resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=           # REQUIRED if LLM_PROVIDER=azure
                                 # e.g. https://my-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
                                 # Stable API version for your resource
# Azure calls models by *deployment name* (created in Azure AI Studio), NOT by
# model id. The adapter maps the registry's logical model ids to the deployment
# names below — create these deployments in your resource, then set the names:
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o                    # chat + vision (GPT-4o family)
AZURE_OPENAI_DEPLOYMENT_CHAT_MINI=gpt-4o-mini          # cheap classification/mapping
AZURE_OPENAI_DEPLOYMENT_EMBEDDING_LARGE=text-embedding-3-large
AZURE_OPENAI_DEPLOYMENT_EMBEDDING_SMALL=text-embedding-3-small

# ── DeepSeek ─────────────────────────────────────────────────────────────────
# OpenAI-compatible endpoint (ADR-0006). No embeddings endpoint — gateway_embed
# falls back to openai/azure automatically (TO-8). Legacy model names
# deepseek-chat / deepseek-reasoner retired 2026-07-24 — V4 names only.
DEEPSEEK_API_KEY=                    # REQUIRED if LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_ENABLED=false        # experimental vision-exp OFF by default (TO-7)
DEEPSEEK_PII_POLICY=block-sensitive  # TO-9: gate PII-bearing docs off the direct API

# ── AWS (Bedrock + Textract) ─────────────────────────────────────────────────
# Used by the Textract OCR backend (ADR-0001) and the Bedrock Claude provider
# (ADR-0002 — adapter pending build; install extras: `pip install -e .[aws]`).
# Prefer IAM roles on EC2/EKS; long-lived keys only for local dev.
AWS_REGION=us-east-1             # Textract/Bedrock are not available in every region
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_ENABLED=false        # Gate for the Bedrock provider (adapter pending)

# ── Gateway (routing, budgets) ───────────────────────────────────────────────
LLM_GATEWAY_STRATEGY=balanced    # cost_optimized | quality_optimized | balanced | manual
                                 #   cost_optimized  — cheapest model per route
                                 #   quality_optimized — best model per route (vision/extraction)
                                 #   balanced        — priority + cost blend
                                 #   manual          — manual per-route overrides via API
# Budgets — ADR-0003 (startup ceiling $500/mo). Exceeding the daily/monthly
# ceiling blocks further LLM spend; session cap guards a single runaway session.
LLM_DAILY_BUDGET_USD=25.0        # $500/mo ÷ ~20 working days
LLM_MONTHLY_BUDGET_USD=500.0     # hard monthly ceiling (F10 gate)
LLM_MAX_PER_SESSION_USD=0.15     # per-session cap

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./storage/sessions.db
                                 # SQLite out of the box; Postgres for production:
                                 # postgresql+asyncpg://user:pass@host:5432/ocr

# ── Vector DB ────────────────────────────────────────────────────────────────
VECTOR_DB_TYPE=memory            # memory | qdrant | pgvector
VECTOR_DB_URL=                   # e.g. http://localhost:6333 (qdrant)
VECTOR_DB_API_KEY=               # qdrant cloud key, if any

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=                       # e.g. redis://localhost:6379/0
                                 # Empty = in-memory fallback for cache/sessions.
                                 # Required for multi-instance deployments.

# ── OCR ──────────────────────────────────────────────────────────────────────
OCR_DEFAULT_STRATEGY=auto        # auto | tesseract | doctr | llm_vision | pdfplumber
                                 # auto = fallback chain
                                 #   pdfplumber → tesseract → doctr → LLM vision
                                 #   (Textract escalation tier per ADR-0001, pending)
OCR_TESSERACT_CMD=tesseract      # path to the tesseract binary if not on PATH

# ── File Upload ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
MAX_PAGE_COUNT=50
UPLOAD_DIR=./uploads             # where uploaded documents land (gitignored)
SCREENSHOT_DIR=./screenshots     # browser automation screenshots (gitignored)

# ── Retention (auto-purge of docs & sessions) ────────────────────────────────
RETENTION_COMPLETED_DAYS=30
RETENTION_FAILED_DAYS=7
RETENTION_ABANDONED_DAYS=1

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_API_KEY=                   # guards /admin endpoints — set a long random
                                 # value (e.g. `openssl rand -hex 32`) in prod
